{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "minLength": 2
    },
    "root_index": {
      "type": "string"
    },
    "doctrine_count": {
      "type": "integer",
      "minimum": 0
    },
    "theme_count": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
