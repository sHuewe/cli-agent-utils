{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "minLength": 2
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "member_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "folder_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "member_ids",
          "title",
          "description",
          "folder_id"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "groups"
  ]
}
