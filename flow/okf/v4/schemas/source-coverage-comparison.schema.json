{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "covered_facets"
  ],
  "properties": {
    "key": {
      "type": "string",
      "minLength": 15
    },
    "covered_facets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "facet_indices"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 4
          },
          "facet_indices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
