{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "missing_item_ids",
    "warnings"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": [
        "ok",
        "needs_revision"
      ]
    },
    "missing_item_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  }
}
